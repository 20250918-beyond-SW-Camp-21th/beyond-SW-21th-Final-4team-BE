        {
          "name": "계약 결제 검증 (PortOne)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"payment_test_abc123\",\n  \"contractId\": {{contractId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/settlements/employer/verify-payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "settlements", "employer", "verify-payment"]
            }
          }
        }
      ]
    },
