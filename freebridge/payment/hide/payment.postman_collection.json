        {
          "name": "청구서 PDF URL 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settlements/employer/{{settlementId}}/invoice",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "settlements", "employer", "{{settlementId}}", "invoice"]
            }
          }
