          }
        },
        {
          "name": "다음 정산 예정 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settlements/employer/next",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "settlements", "employer", "next"]
            }
          }
        },
        {
          "name": "고용주 정산 상세 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settlements/employer/{{settlementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "settlements", "employer", "{{settlementId}}"]
            }
          }
