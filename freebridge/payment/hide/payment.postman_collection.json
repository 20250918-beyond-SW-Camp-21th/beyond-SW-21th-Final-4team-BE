    {
      "name": "Employer Settlement",
      "item": [
        {
          "name": "고용주 정산 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settlements/employer?status=ALL&dateRange=ALL&sort=DUE_DATE_ASC&page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "settlements", "employer"],
              "query": [
                { "key": "status", "value": "ALL", "description": "ALL | ISSUED | PAID | DISBURSED | CANCELLED" },
                { "key": "dateRange", "value": "ALL", "description": "ALL | LAST_3_MONTHS | LAST_6_MONTHS | LAST_1_YEAR" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "sort", "value": "DUE_DATE_ASC", "description": "DUE_DATE_ASC | DUE_DATE_DESC | AMOUNT_ASC | AMOUNT_DESC" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "고용주 정산 통계 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settlements/employer/summary",
