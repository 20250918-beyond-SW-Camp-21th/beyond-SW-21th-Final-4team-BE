{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Freebridge - Payment Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token from POST /api/v1/users/login"
    },
    {
      "key": "settlementId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "contractId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "billingId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Wallet",
      "item": [
        {
          "name": "고용주 지갑 요약 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/employer/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallets", "employer", "summary"]
            }
          }
        },
        {
          "name": "고용주 거래 내역 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/employer/transactions?referenceType=ALL&page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallets", "employer", "transactions"],
              "query": [
                { "key": "referenceType", "value": "ALL", "description": "ALL | CONTRACT_PAYMENT | FREELANCER_DISBURSEMENT | PLATFORM_FEE | SUBSCRIPTION_PAYMENT | REFUND" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "프리랜서 지갑 요약 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/freelancer/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallets", "freelancer", "summary"]
            }
          }
        },
        {
          "name": "프리랜서 거래 내역 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/freelancer/transactions?page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallets", "freelancer", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "[Admin] 플랫폼 에스크로 잔액 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/platform/escrow",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallets", "platform", "escrow"]
            }
          }
        },
        {
          "name": "[Admin] 플랫폼 수익 잔액 조회",
          "request": {
            "method": "GET",
            "header": [],
